# ========================================
# NEUROFORGE BACKEND - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080
SERVER_ADDRESS=localhost
SERVER_CONTEXT_PATH=/api

# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL Configuration (Default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/neuroforge_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# MySQL Configuration (Alternative - uncomment if using MySQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/neuroforge_db
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password_here
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ========================================
# JPA/HIBERNATE CONFIGURATION
# ========================================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ========================================
# JWT (JSON Web Token) CONFIGURATION
# ========================================
# IMPORTANT: Use a strong secret key (min 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_use_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# SPRING SECURITY
# ========================================
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin123

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_NEUROFORGE=DEBUG
LOGGING_FILE_NAME=logs/neuroforge.log
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# ========================================
# SPRING ACTUATOR
# ========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_ENDPOINT_METRICS_ENABLED=true

# ========================================
# SWAGGER / OPENAPI
# ========================================
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/v3/api-docs

# ========================================
# APPLICATION PROFILES
# ========================================
# dev - Development (default)
# test - Testing
# prod - Production
SPRING_PROFILES_ACTIVE=dev

# ========================================
# DATABASE INITIALIZATION (for dev only)
# ========================================
# Set to true to populate database with sample data on startup
# APP_DATABASE_INITIALIZE=false